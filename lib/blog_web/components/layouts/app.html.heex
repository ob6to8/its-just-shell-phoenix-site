<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-800 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center gap-2 font-mono text-lg font-bold hover:opacity-80">
        <img src={~p"/images/logo.png"} alt="its just shell" class="h-7 w-7 rounded" />
        <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">its-just-shell</span>
      </a>
    </div>
    <div class="flex items-center gap-4 font-mono text-sm leading-6 text-zinc-400">
      <.link href={~p"/posts"} class="hover:text-terminal-green transition-colors">
        posts
      </.link>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
