<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-[var(--border)] py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center gap-2 font-mono text-lg font-bold hover:opacity-80">
        <img src={@current_site.logo_path} alt={@current_site.name} class="h-7 w-7 rounded" />
        <span class="bg-gradient-to-r from-[var(--gradient-from)] to-[var(--gradient-to)] bg-clip-text text-transparent"><%= @current_site.name %></span>
      </a>
    </div>
    <div class="flex items-center gap-4 font-mono text-sm leading-6 text-[var(--text-secondary)]">
      <.link href={~p"/posts"} class="hover:text-[var(--accent)] transition-colors">
        posts
      </.link>
      <.link href={~p"/feed"} class="hover:text-[var(--accent)] transition-colors">
        feed
      </.link>
      <.link href={~p"/about"} class="hover:text-[var(--accent)] transition-colors">
        about
      </.link>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
