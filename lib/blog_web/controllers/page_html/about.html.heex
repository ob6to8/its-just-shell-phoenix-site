<div class="space-y-8">
  <h1 class="text-3xl font-bold font-mono text-[var(--text)]">about</h1>

  <div class="prose prose-invert prose-terminal max-w-none">
    <p><%= @current_site.about_text %></p>
  </div>

  <div class="flex items-center gap-6 font-mono text-sm">
    <a href="https://github.com/Its-Just-Shell" target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
      github
    </a>
    <a href="https://x.com/itsjustshelldev" target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
      x.com
    </a>
  </div>
</div>
