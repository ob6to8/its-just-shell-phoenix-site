<div class="space-y-8">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold font-mono text-[var(--text)]">research</h1>

    <div class="flex flex-wrap gap-2 mt-4">
      <a
        href={~p"/research"}
        class={"px-3 py-1 rounded-full text-xs font-mono border transition-colors " <>
          if(@current_type == nil,
            do: "bg-[var(--accent)] text-[var(--bg)] border-[var(--accent)]",
            else: "text-[var(--text-secondary)] border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
          )}
      >
        all
      </a>
      <%= for type <- @types do %>
        <a
          href={~p"/research?type=#{type}"}
          class={"px-3 py-1 rounded-full text-xs font-mono border transition-colors " <>
            if(@current_type == type,
              do: "bg-[var(--accent)] text-[var(--bg)] border-[var(--accent)]",
              else: "text-[var(--text-secondary)] border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
            )}
        >
          <%= type %>
        </a>
      <% end %>
    </div>
  </div>

  <%= if Enum.empty?(@grouped_items) do %>
    <p class="text-[var(--text-secondary)]">No research items yet.</p>
  <% else %>
    <%= if @current_type == "site" do %>
      <div class="space-y-2">
        <%= for {_month_label, items} <- @grouped_items, item <- items do %>
          <div class="flex items-baseline gap-2 text-sm font-mono">
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-[var(--text)] hover:text-[var(--accent)] transition-colors whitespace-nowrap">
              <%= item.title %> <span class="text-xs text-[var(--text-secondary)]">&#8599;</span>
            </a>
            <span class="text-[var(--text-secondary)] text-xs truncate"><%= raw(String.replace(item.body, ~r/<[^>]+>/, "")) %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= for {month_label, items} <- @grouped_items do %>
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono text-[var(--text-secondary)] whitespace-nowrap"><%= month_label %></span>
          <hr class="flex-1 border-[var(--border)]" />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for item <- items do %>
            <article class="rounded-lg border border-[var(--border)] bg-[var(--surface)] p-5 flex flex-col gap-3">
              <h2 class="font-mono text-base font-semibold leading-snug">
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-[var(--text)] hover:text-[var(--accent)] transition-colors">
                  <%= item.title %> <span class="text-xs text-[var(--text-secondary)]">&#8599;</span>
                </a>
              </h2>
              <span class="inline-block self-start px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider text-[var(--accent)] border border-[var(--accent)]/30 bg-[var(--accent)]/10">
                <%= item.type %>
              </span>
              <p class="text-xs font-mono text-[var(--text-secondary)]">
                <%= item.source %> &middot; <%= item.published %>
              </p>
              <div class="text-sm text-[var(--text-secondary)] prose prose-invert prose-terminal prose-sm max-w-none [&_ul]:list-disc [&_ul]:pl-4 [&_ul]:space-y-1 [&_li]:text-sm">
                <%= raw(item.body) %>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
