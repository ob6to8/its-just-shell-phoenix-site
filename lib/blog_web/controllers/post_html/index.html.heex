<div class="space-y-8">
  <h1 class="text-3xl font-bold font-mono text-zinc-100">posts</h1>

  <%= if Enum.empty?(@posts) do %>
    <p class="text-zinc-500">No posts yet.</p>
  <% else %>
    <div class="space-y-6">
      <%= for post <- @posts do %>
        <article class="border-b border-zinc-800 pb-6">
          <.link href={~p"/posts/#{post.id}"} class="group">
            <h2 class="font-mono text-xl font-semibold text-zinc-100 group-hover:text-purple-400 transition-colors"><%= post.title %></h2>
          </.link>
          <p class="mt-1 text-sm font-mono text-zinc-600"><%= format_date(post.date) %></p>
          <p class="mt-2 text-zinc-400 line-clamp-2"><%= post.description %></p>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
