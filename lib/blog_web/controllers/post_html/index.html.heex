<div class="space-y-8">
  <h1 class="text-3xl font-bold">Posts</h1>

  <%= if Enum.empty?(@posts) do %>
    <p class="text-zinc-500">No posts yet.</p>
  <% else %>
    <div class="space-y-6">
      <%= for post <- @posts do %>
        <article class="border-b border-zinc-100 pb-6">
          <.link href={~p"/posts/#{post.id}"} class="group">
            <h2 class="text-xl font-semibold group-hover:text-zinc-600"><%= post.title %></h2>
          </.link>
          <p class="mt-1 text-sm text-zinc-500"><%= format_date(post.date) %></p>
          <p class="mt-2 text-zinc-700 line-clamp-2"><%= post.description %></p>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
