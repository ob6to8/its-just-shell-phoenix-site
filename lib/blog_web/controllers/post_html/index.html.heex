<div class="space-y-8">
  <h1 class="text-3xl font-bold font-mono text-[var(--text)]">posts</h1>

  <%= if Enum.empty?(@posts) do %>
    <p class="text-[var(--text-secondary)]">No posts yet.</p>
  <% else %>
    <div class="space-y-6">
      <%= for post <- @posts do %>
        <article class="border-b border-[var(--border)] pb-6">
          <.link href={~p"/posts/#{post.id}"} class="group">
            <h2 class="font-mono text-xl font-semibold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors"><%= post.title %></h2>
          </.link>
          <p class="mt-1 text-sm font-mono text-[var(--text-secondary)]"><%= format_date(post.date) %></p>
          <p class="mt-2 text-[var(--text-secondary)] line-clamp-2"><%= post.description %></p>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
