<article class="space-y-6">
  <div>
    <.link href={~p"/posts"} class="text-sm text-zinc-500 hover:text-zinc-700">&larr; Back to posts</.link>
  </div>

  <header>
    <h1 class="text-3xl font-bold"><%= @post.title %></h1>
    <p class="mt-2 text-sm text-zinc-500"><%= format_date(@post.date) %></p>
  </header>

  <div class="prose max-w-none">
    <%= raw(@post.body) %>
  </div>
</article>
