<article class="space-y-6">
  <div>
    <.link href={~p"/posts"} class="text-sm text-zinc-500 hover:text-zinc-700">&larr; Back to posts</.link>
  </div>

  <header>
    <h1 class="text-3xl font-bold"><%= @post.title %></h1>
    <p class="mt-2 text-sm text-zinc-500"><%= format_date(@post.published_at) %></p>
  </header>

  <div class="prose max-w-none">
    <p class="whitespace-pre-wrap"><%= @post.body %></p>
  </div>

  <div class="flex gap-4 border-t border-zinc-100 pt-4">
    <.link href={~p"/posts/#{@post}/edit"} class="text-sm font-semibold text-zinc-900 hover:text-zinc-700">
      Edit
    </.link>
    <.link href={~p"/posts/#{@post}"} method="delete" data-confirm="Are you sure?" class="text-sm font-semibold text-red-600 hover:text-red-500">
      Delete
    </.link>
  </div>
</article>
