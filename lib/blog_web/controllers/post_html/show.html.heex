<article class="max-w-2xl mx-auto space-y-6">
  <div>
    <.link href={~p"/posts"} class="text-sm font-mono text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">&larr; back to posts</.link>
  </div>

  <header>
    <h1 class="text-3xl font-bold font-mono text-[var(--text)]"><%= @post.title %></h1>
    <p class="mt-2 text-sm font-mono text-[var(--text-secondary)]"><%= format_date(@post.date) %></p>
  </header>

  <div class="prose prose-invert prose-terminal max-w-none">
    <%= raw(@post.body) %>
  </div>
</article>
