---
import { formatDate } from "../lib/content";

interface Props {
  slug: string;
  title: string;
  date: Date;
  description: string;
}

const { slug, title, date, description } = Astro.props;
---

<article class="border-b border-[var(--border)] pb-6">
  <a href={`/posts/${slug}`} class="group">
    <h2
      class="font-mono text-xl font-semibold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors"
    >
      {title}
    </h2>
  </a>
  <p class="mt-1 text-sm font-mono text-[var(--text-secondary)]">
    {formatDate(date)}
  </p>
  <p class="mt-2 text-[var(--text-secondary)] line-clamp-2">{description}</p>
</article>
