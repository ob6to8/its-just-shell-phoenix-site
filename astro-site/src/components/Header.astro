---
import { getCurrentSite } from "../config/sites";
const site = getCurrentSite();
---

<header class="px-4 sm:px-6 lg:px-8">
  <div
    class="flex items-center justify-between border-b border-[var(--border)] py-3 text-sm"
  >
    <div class="flex items-center gap-4">
      <a
        href="/"
        class="flex items-center gap-2 font-mono text-lg font-bold hover:opacity-80"
      >
        <img
          src={site.logoPath}
          alt={site.name}
          class="h-7 w-7 rounded"
        />
        <span
          class="bg-gradient-to-r from-[var(--gradient-from)] to-[var(--gradient-to)] bg-clip-text text-transparent"
          >{site.name}</span
        >
      </a>
    </div>
    <div
      class="flex items-center gap-4 font-mono text-sm leading-6 text-[var(--text-secondary)]"
    >
      <a
        href="/posts"
        class="hover:text-[var(--accent)] transition-colors">posts</a
      >
      <a
        href="/research"
        class="hover:text-[var(--accent)] transition-colors">research</a
      >
      <a
        href="/about"
        class="hover:text-[var(--accent)] transition-colors">about</a
      >
    </div>
  </div>
</header>
